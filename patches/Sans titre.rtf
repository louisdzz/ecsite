def cut(a, b, neuf):\
    """Remplace la region entre deux ancres, ancres comprises."""\
    global s\
    i = s.find(a)\
    j = s.find(b, i)\
    if i < 0 or j < 0:\
        e.append("ECHEC ancre introuvable : %s" % a[:50]); return\
    s = s[:i] + neuf + s[j + len(b):]\
