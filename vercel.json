{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/ecosysteme",
      "destination": "/annuaire",
      "permanent": true
    },
    {
      "source": "/ecosysteme.html",
      "destination": "/annuaire",
      "permanent": true
    },
    {
      "source": "/classement",
      "destination": "/annuaire",
      "permanent": true
    },
    {
      "source": "/classement.html",
      "destination": "/annuaire",
      "permanent": true
    },
    {
      "source": "/ligues",
      "destination": "/ecosysteme-ligues#ligues",
      "permanent": false
    },
    {
      "source": "/ligues.html",
      "destination": "/ecosysteme-ligues#ligues",
      "permanent": false
    },
    {
      "source": "/statistiques-confidentialite",
      "destination": "/confidentialite",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.promotekit.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https:; frame-src 'self' https://tally.so https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://tally.so; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/_build/:path*",
      "destination": "/api/private-path"
    },
    {
      "source": "/sheet",
      "destination": "/api/private-path"
    },
    {
      "source": "/sheet.html",
      "destination": "/api/private-path"
    }
  ]
}
